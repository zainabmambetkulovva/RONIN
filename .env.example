# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Base URL (для ngrok тестирования оставьте пустым, для production - укажите домен)
NEXT_PUBLIC_APP_URL=""

# NextAuth
NEXTAUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (получи на https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend Email API (получи на https://resend.com) - опционально
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="noreply@yourdomain.com"

# Telegram Bot для 2FA админ панели
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
# Telegram Admin Chat ID для уведомлений (получить: отправьте /start боту, затем node get-telegram-chat-id.js)
TELEGRAM_ADMIN_CHAT_ID="your-admin-chat-id"

# Контакты RONIN
CONTACT_PHONE="+996501004700"
CONTACT_EMAIL="info@ronin.kg"
CONTACT_ADDRESS="г. Бишкек, ул. Горького 130, 2 этаж"
INSTAGRAM_URL="https://www.instagram.com/ronin__kg"
TELEGRAM_URL="https://t.me/ronin_support"
WHATSAPP_URL="https://wa.me/996501004700"
GIS_2_URL="https://2gis.kg/bishkek"

# FINIK PAY (платежная система) - опционально
FINIK_ENV="prod"
FINIK_API_KEY="your-finik-api-key"
FINIK_ACCOUNT_ID="your-finik-account-id"
FINIK_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
your-private-key-here
-----END PRIVATE KEY-----"

# Groq — ИИ-ассистент (бесплатный ключ: console.groq.com → API Keys, начинается с gsk_)
GROQ_API_KEY=""
# Необязательно: модель Groq (по умолчанию llama-3.3-70b-versatile)
# GROQ_MODEL="llama-3.3-70b-versatile"

# Секрет для cron-задачи /api/cron/expire-bookings (Vercel Cron передаёт его автоматически)
CRON_SECRET="generate-with: openssl rand -hex 32"

# Redis для общего rate limiting между инстансами (рекомендуется в production)
REDIS_URL=""

# ТОЛЬКО для локальной разработки: демо-оплата без Finik. В production не включать.
ENABLE_DEMO_PAYMENTS="false"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model accounts {
  id                  String  @id
  user_id             String
  type                String
  provider            String
  provider_account_id String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  users               users   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
}

model ai_chats {
  id          String        @id
  user_id     String
  provider    AiProvider
  created_at  DateTime      @default(now())
  updated_at  DateTime
  users       users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ai_messages ai_messages[]
}

model ai_messages {
  id         String   @id
  chat_id    String
  role       AiRole
  message    String
  created_at DateTime @default(now())
  ai_chats   ai_chats @relation(fields: [chat_id], references: [id], onDelete: Cascade)
}

model audit_logs {
  id          String   @id
  user_id     String
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(100)
  entity_id   String?
  old_data    Json?
  new_data    Json?
  created_at  DateTime @default(now())
  users       users    @relation(fields: [user_id], references: [id])
}

model auth_sessions {
  id            String   @id
  session_token String   @unique
  user_id       String
  expires       DateTime
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model avatars {
  id        String  @id
  code      String  @unique @db.VarChar(20)
  image_url String
  is_active Boolean @default(true)
}

model booking_status_history {
  id         String         @id
  booking_id String
  old_status BookingStatus?
  new_status BookingStatus
  changed_by String
  reason     String?
  created_at DateTime       @default(now())
  bookings   bookings       @relation(fields: [booking_id], references: [id])
  users      users          @relation(fields: [changed_by], references: [id])
}

model bookings {
  id                     String                   @id
  booking_number         String                   @unique @db.VarChar(30)
  user_id                String
  computer_id            String
  tariff_id              String
  start_at               DateTime
  end_at                 DateTime
  duration_minutes       Int
  price                  Decimal                  @db.Decimal(10, 2)
  status                 BookingStatus            @default(pending)
  qr_token               String                   @unique @db.VarChar(255)
  created_at             DateTime                 @default(now())
  updated_at             DateTime
  booking_code           String                   @unique @db.VarChar(5)
  is_expired             Boolean                  @default(false)
  payment_status         PaymentStatus?           @default(pending)
  payment_method         String?                  @db.VarChar(50)
  transaction_id         String?                  @db.VarChar(255)
  paid_at                DateTime?
  booking_status_history booking_status_history[]
  computers              computers                @relation(fields: [computer_id], references: [id])
  tariffs                tariffs                  @relation(fields: [tariff_id], references: [id])
  users                  users                    @relation(fields: [user_id], references: [id])
  gaming_sessions        gaming_sessions[]
  payments               payments[]
}

model computer_categories {
  id          String      @id
  name        String      @db.VarChar(100)
  description String
  image_url   String?
  is_active   Boolean     @default(true)
  created_at  DateTime    @default(now())
  updated_at  DateTime
  computers   computers[]
  tariffs     tariffs[]
}

model computers {
  id                  String              @id
  category_id         String
  number              Int                 @unique
  specifications      Json
  image_url           String?
  status              ComputerStatus      @default(available)
  created_at          DateTime            @default(now())
  updated_at          DateTime
  bookings            bookings[]
  computer_categories computer_categories @relation(fields: [category_id], references: [id])
  gaming_sessions     gaming_sessions[]
}

model content {
  id          String      @id
  type        ContentType
  title       String?     @db.VarChar(255)
  description String?
  image_url   String?
  is_active   Boolean     @default(true)
  created_by  String
  updated_at  DateTime
  users       users       @relation(fields: [created_by], references: [id])
}

model gaming_sessions {
  id          String              @id
  booking_id  String
  computer_id String
  started_by  String
  started_at  DateTime
  ended_at    DateTime?
  status      GamingSessionStatus @default(active)
  created_at  DateTime            @default(now())
  bookings    bookings            @relation(fields: [booking_id], references: [id])
  computers   computers           @relation(fields: [computer_id], references: [id])
  users       users               @relation(fields: [started_by], references: [id])
}

model notifications {
  id         String   @id
  user_id    String
  type       String   @db.VarChar(50)
  title      String   @db.VarChar(255)
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model otp_codes {
  id          String    @id
  user_id     String?
  destination String    @db.VarChar(255)
  code_hash   String    @db.VarChar(255)
  type        OtpType
  expires_at  DateTime
  attempts    Int       @default(0)
  used_at     DateTime?
  created_at  DateTime  @default(now())
  users       users?    @relation(fields: [user_id], references: [id])
}

model password_reset_tokens {
  id         String    @id
  user_id    String
  token      String    @unique @db.VarChar(6)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model payments {
  id             String        @id
  booking_id     String
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  status         PaymentStatus @default(pending)
  provider       String?       @db.VarChar(100)
  transaction_id String?       @db.VarChar(255)
  paid_at        DateTime?
  refunded_at    DateTime?
  created_at     DateTime      @default(now())
  bookings       bookings      @relation(fields: [booking_id], references: [id])
}

model sessions {
  id         String    @id
  user_id    String
  token_hash String    @db.VarChar(255)
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())
  ip_address String?   @db.VarChar(45)
  user_agent String?
}

model tariffs {
  id                  String               @id
  category_id         String?
  name                String               @db.VarChar(100)
  duration_minutes    Int
  price               Decimal              @db.Decimal(10, 2)
  type                TariffType
  is_active           Boolean              @default(true)
  created_at          DateTime             @default(now())
  updated_at          DateTime
  bookings            bookings[]
  computer_categories computer_categories? @relation(fields: [category_id], references: [id])
}

model two_factor_codes {
  id         String    @id
  user_id    String
  code       String    @db.VarChar(6)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
}

model users {
  id                     String                   @id
  name                   String                   @db.VarChar(100)
  phone                  String?                  @unique @db.VarChar(20)
  email                  String?                  @unique @db.VarChar(255)
  role                   UserRole                 @default(client)
  status                 UserStatus               @default(active)
  created_at             DateTime                 @default(now())
  updated_at             DateTime
  avatar                 String?                  @db.VarChar(50)
  email_verified         DateTime?
  image                  String?
  password               String?                  @db.VarChar(255)
  telegram_chat_id       String?                  @unique @db.VarChar(50)
  accounts               accounts[]
  ai_chats               ai_chats[]
  audit_logs             audit_logs[]
  auth_sessions          auth_sessions[]
  booking_status_history booking_status_history[]
  bookings               bookings[]
  content                content[]
  gaming_sessions        gaming_sessions[]
  notifications          notifications[]
  otp_codes              otp_codes[]
  password_reset_tokens  password_reset_tokens[]
  telegram_verifications telegram_verifications[]
}

model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum AiProvider {
  openai
  gemini
}

enum AiRole {
  user
  assistant
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
  expired
}

enum ComputerStatus {
  available
  maintenance
}

enum ContentType {
  banner
  text
  image
}

enum GamingSessionStatus {
  active
  completed
  expired
}

enum OtpType {
  registration
  login
}

enum PaymentMethod {
  electronic_wallet
  cash
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum TariffType {
  hourly
  package
  night
  morning
}

enum UserRole {
  client
  manager
  admin
}

enum UserStatus {
  active
  blocked
  deleted
}


model telegram_verifications {
  id         String   @id @default(cuid())
  user_id    String   @unique
  code       String
  expires_at DateTime
  created_at DateTime @default(now())
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}


model settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}
